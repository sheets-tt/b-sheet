# syntax=docker/dockerfile:1
# Servidor HTTP (Netty) de b-sheet para el ambiente de pruebas en la Raspberry Pi (rama "testing").
# No es la imagen de producción: esa es Dockerfile (AWS Lambda), que no escucha HTTP.
# Se compila con el perfil "dev" de Maven, que agrega micronaut-http-server-netty al jar.

FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY mvnw pom.xml ./
COPY .mvn .mvn
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -q -Pdev dependency:go-offline
COPY src src
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -q -Pdev package -DskipTests

FROM eclipse-temurin:25-jre
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=build /src/target/sheets-backend-lambda.jar app.jar
USER app
ENV PORT=8080 \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=60s --retries=5 \
  CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080 && printf 'GET /health HTTP/1.0\\r\\n\\r\\n' >&3 && grep -q ' 200 ' <&3"]
ENTRYPOINT ["java", "-cp", "/app/app.jar", "tt.sheets.Application"]
